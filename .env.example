# Copy this file to ".env" (same folder) and fill in your real values.
# ".env" itself should never be committed/shared -- it holds your secrets.
# Lines you leave blank just mean that feature/channel is disabled.

# --- Alpaca (price data -- primary source) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Finnhub (earnings calendar, news, company info -- optional but recommended) ---
FINNHUB_API_KEY=

# --- ntfy (free push notifications) ---
NTFY_TOPIC=

# --- Email (optional alert channel, also used for the legacy email_sms gateway) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=
SMS_GATEWAY_ADDRESS=

# --- Twilio (optional, real SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=

# --- Dashboard link included in alert texts ---
DASHBOARD_URL=http://127.0.0.1:5000
